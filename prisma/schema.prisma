generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled endpoint for the app's queries.
  url       = env("DATABASE_URL")
  // Neon's pooler cannot run migrations, so Prisma Migrate uses the direct
  // (non-pooler) endpoint instead.
  directUrl = env("DIRECT_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String?             @unique
  name               String?
  username           String              @unique
  password           String
  image              String?
  balance            Float               @default(1000)
  isPaused           Boolean             @default(false)
  isBanned           Boolean             @default(false)
  emailVerified      DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  accounts           Account[]
  sessions           Session[]
  holdings           Holding[]
  transactions       Transaction[]
  sellOffers         SellOffer[]         @relation("SellerOffers")
  buyOffers          BuyOffer[]          @relation("BuyerOffers")
  cryptoHoldings     CryptoHolding[]
  cryptoTransactions CryptoTransaction[]
  managedFirms       Firm[]              @relation("FirmManager")
  firmMemberships    FirmMembership[]
  newsPosts          NewsPost[]          @relation("NewsAuthor")
  firmNews           FirmNews[]          @relation("FirmNewsAuthor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id           String        @id @default(cuid())
  symbol       String        @unique
  name         String
  createdAt    DateTime      @default(now())
  prices       PricePoint[]
  holdings     Holding[]
  transactions Transaction[]
  sellOffers   SellOffer[]
  firmHoldings FirmHolding[]
}

model PricePoint {
  id                String   @id @default(cuid())
  label             String
  value             Float
  companyValue      Float?
  sharesOutstanding Int?
  companyId         String
  createdAt         DateTime @default(now())
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Holding {
  id        String  @id @default(cuid())
  userId    String
  companyId String
  shares    Int     @default(0)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  type      String // BUY or SELL
  shares    Int
  price     Float
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model SellOffer {
  id            String    @id @default(cuid())
  sellerId      String
  companyId     String
  shares        Int
  pricePerShare Float
  status        String    @default("active") // active, completed, cancelled
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?

  /// Set when the listing belongs to a firm; sellerId is then the manager who placed it.
  firmId String?

  seller    User       @relation("SellerOffers", fields: [sellerId], references: [id], onDelete: Cascade)
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  firm      Firm?      @relation("FirmSellOffers", fields: [firmId], references: [id], onDelete: Cascade)
  buyOffers BuyOffer[]

  @@index([status, createdAt])
  @@index([firmId, status])
}

model BuyOffer {
  id           String   @id @default(cuid())
  sellOfferId  String
  buyerId      String
  offeredPrice Float
  shares       Int
  status       String   @default("pending") // pending, accepted, declined
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Set when the bid comes from a firm; buyerId is then the manager who placed it.
  firmId String?

  sellOffer SellOffer @relation(fields: [sellOfferId], references: [id], onDelete: Cascade)
  buyer     User      @relation("BuyerOffers", fields: [buyerId], references: [id], onDelete: Cascade)
  firm      Firm?     @relation("FirmBuyOffers", fields: [firmId], references: [id], onDelete: Cascade)

  @@index([sellOfferId, status])
  @@index([firmId, status])
}

model Crypto {
  id          String   @id @default(cuid())
  symbol      String   @unique
  name        String
  description String?
  /// Seed for the deterministic price walk. Same seed + same clock = same price everywhere.
  seed        Int
  /// Price at genesisAt, before any ticks have been applied.
  basePrice   Float    @default(1)
  /// Per-tick volatility (standard deviation of the log return).
  volatility  Float    @default(0.02)
  /// Per-tick drift of the log return.
  drift       Float    @default(0)
  minPrice    Float    @default(0.01)
  maxPrice    Float?
  isActive    Boolean  @default(true)
  genesisAt   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  holdings     CryptoHolding[]
  transactions CryptoTransaction[]
  firmHoldings FirmCryptoHolding[]
}

model CryptoHolding {
  id       String @id @default(cuid())
  userId   String
  cryptoId String
  units    Float  @default(0)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  crypto   Crypto @relation(fields: [cryptoId], references: [id], onDelete: Cascade)

  @@unique([userId, cryptoId])
}

model CryptoTransaction {
  id        String   @id @default(cuid())
  userId    String
  cryptoId  String
  type      String // BUY or SELL
  units     Float
  price     Float
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  crypto    Crypto   @relation(fields: [cryptoId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Firm {
  id                 String   @id @default(cuid())
  name               String   @unique
  slug               String   @unique
  description        String?
  managerId          String
  /// Uninvested cash held by the firm on behalf of its clients.
  balance            Float    @default(0)
  /// Total fund units issued to clients. NAV per unit = (balance + holdings) / totalUnits.
  totalUnits         Float    @default(0)
  /// Percentage of each client deposit taken by the manager as a fee.
  depositFeePercent  Float    @default(0)
  /// Percentage of each client withdrawal taken by the manager as a fee.
  withdrawFeePercent Float    @default(0)
  isOpen             Boolean  @default(true)
  isClosed           Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  manager        User                @relation("FirmManager", fields: [managerId], references: [id], onDelete: Cascade)
  members        FirmMembership[]
  sellOffers     SellOffer[]         @relation("FirmSellOffers")
  buyOffers      BuyOffer[]          @relation("FirmBuyOffers")
  holdings       FirmHolding[]
  cryptoHoldings FirmCryptoHolding[]
  transactions   FirmTransaction[]
  FirmNews       FirmNews[]

  @@index([isClosed, createdAt])
}

model FirmMembership {
  id         String   @id @default(cuid())
  firmId     String
  userId     String
  /// Fund units owned by this client.
  units      Float    @default(0)
  /// Lifetime cash deposited, used to show the client's profit/loss.
  invested   Float    @default(0)
  /// Lifetime cash withdrawn.
  withdrawn  Float    @default(0)
  /// Whether this client wants the firm's email updates.
  emailOptIn Boolean  @default(true)
  joinedAt   DateTime @default(now())

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([firmId, userId])
}

model FirmHolding {
  id        String  @id @default(cuid())
  firmId    String
  companyId String
  shares    Int     @default(0)
  firm      Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([firmId, companyId])
}

model FirmCryptoHolding {
  id       String @id @default(cuid())
  firmId   String
  cryptoId String
  units    Float  @default(0)
  firm     Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  crypto   Crypto @relation(fields: [cryptoId], references: [id], onDelete: Cascade)

  @@unique([firmId, cryptoId])
}

model FirmTransaction {
  id        String   @id @default(cuid())
  firmId    String
  /// BUY, SELL, DEPOSIT or WITHDRAW
  type      String
  /// STOCK, CRYPTO or CASH
  assetType String   @default("STOCK")
  assetId   String?
  symbol    String?
  units     Float
  price     Float
  amount    Float
  actorId   String?
  createdAt DateTime @default(now())

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId, createdAt])
}

/// Site-wide announcements. Only the operator writes these.
model NewsPost {
  id          String    @id @default(cuid())
  title       String
  body        String
  /// Pinned posts sort to the top of the news page.
  isPinned    Boolean   @default(false)
  isPublished Boolean   @default(true)
  /// Set once the post has been emailed, so it never goes out twice.
  emailedAt   DateTime?
  authorId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author User @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([isPublished, isPinned, createdAt])
}

/// An update a firm's manager sends to that firm's investors.
model FirmNews {
  id         String    @id @default(cuid())
  firmId     String
  authorId   String
  title      String
  body       String
  /// Set once the update has been emailed to the firm's clients.
  emailedAt  DateTime?
  recipients Int       @default(0)
  createdAt  DateTime  @default(now())

  firm   Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)
  author User @relation("FirmNewsAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([firmId, createdAt])
}
