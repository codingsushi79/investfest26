# Required Environment Variables
DATABASE_URL=postgresql://user:password@host:5432/investfest
# Direct (non-pooler) connection for Prisma Migrate. On Neon this is the
# same URL with "-pooler" removed from the host.
DIRECT_URL=postgresql://user:password@host:5432/investfest
NEXTAUTH_SECRET=your-random-secret-key-here

# Branding (client-side accessible)
NEXT_PUBLIC_APP_TITLE=InvestFest
NEXT_PUBLIC_APP_DESCRIPTION=Virtual stock trading game

# Trading Settings (server-side only)
SELL_TO_MARKET_PERCENTAGE=90
STARTING_BALANCE=1000
MAX_TRADING_PERIOD=Y5 Q4

# Feature Toggles (server-side)
FEATURE_TRADING=true
FEATURE_LEADERBOARD=true
FEATURE_PORTFOLIOS=true
FEATURE_OFFERS=true
FEATURE_MODERATOR_TOOLS=true
FEATURE_ADMIN_PRICE_UPDATES=true
FEATURE_USER_PROFILES=true
FEATURE_USER_REGISTRATION=true
FEATURE_ANALYTICS=true
FEATURE_CRYPTO=true
FEATURE_CRYPTO_CREATION=true
FEATURE_CRYPTO_TRADING=true
FEATURE_FIRMS=true
FEATURE_FIRM_CREATION=true
FEATURE_FIRM_TRADING=true
FEATURE_BULK_PRICE_UPDATES=true
FEATURE_NEWS=true
FEATURE_NEWS_EMAIL=true
FEATURE_FIRM_NEWS=true
FEATURE_FIRM_NEWS_EMAIL=true

# Feature Toggles (client-side accessible - NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_FEATURE_TRADING=true
NEXT_PUBLIC_FEATURE_LEADERBOARD=true
NEXT_PUBLIC_FEATURE_PORTFOLIOS=true
NEXT_PUBLIC_FEATURE_OFFERS=true
NEXT_PUBLIC_FEATURE_MODERATOR_TOOLS=true
NEXT_PUBLIC_FEATURE_ADMIN_PRICE_UPDATES=true
NEXT_PUBLIC_FEATURE_USER_PROFILES=true
NEXT_PUBLIC_FEATURE_USER_REGISTRATION=true
NEXT_PUBLIC_FEATURE_ANALYTICS=true
NEXT_PUBLIC_FEATURE_CRYPTO=true
NEXT_PUBLIC_FEATURE_CRYPTO_CREATION=true
NEXT_PUBLIC_FEATURE_CRYPTO_TRADING=true
NEXT_PUBLIC_FEATURE_FIRMS=true
NEXT_PUBLIC_FEATURE_FIRM_CREATION=true
NEXT_PUBLIC_FEATURE_FIRM_TRADING=true
NEXT_PUBLIC_FEATURE_BULK_PRICE_UPDATES=true
NEXT_PUBLIC_FEATURE_NEWS=true
NEXT_PUBLIC_FEATURE_NEWS_EMAIL=true
NEXT_PUBLIC_FEATURE_FIRM_NEWS=true
NEXT_PUBLIC_FEATURE_FIRM_NEWS_EMAIL=true

# Crypto (server-side)
# Prices move on their own every tick; nobody can set them.
CRYPTO_TICK_SECONDS=60
CRYPTO_DEFAULT_START_PRICE=1
CRYPTO_DEFAULT_VOLATILITY=0.02
# Average trend in percent per hour. 0 means the coin has no built-in
# direction; a coin that reliably climbs is free money for whoever holds it,
# so the create form is capped at MAX_TREND_PERCENT_PER_HOUR either way.
CRYPTO_DEFAULT_TREND_PERCENT_PER_HOUR=0
CRYPTO_MAX_TREND_PERCENT_PER_HOUR=15
CRYPTO_MAX_VOLATILITY=0.06
CRYPTO_MIN_PRICE=0.01
CRYPTO_SELL_FEE_PERCENTAGE=0
CRYPTO_MAX_COINS=50
CRYPTO_HISTORY_POINTS=60

# Investment firms (server-side)
FIRM_MAX_FEE_PERCENTAGE=10
FIRM_MIN_DEPOSIT=10
FIRM_MAX_PER_MANAGER=1
FIRM_MAX_MEMBERS=100
FIRM_ALLOW_CRYPTO=true

# Live updates (client-side)
# How often pages re-poll for balances, prices and offers, in milliseconds.
# Lower is snappier and chattier; raise it if the app feels too busy.
NEXT_PUBLIC_LIVE_REFRESH_MS=8000

# Authentication
OP_USERNAME=operator
NEXT_PUBLIC_OP_USERNAME=operator
REQUIRE_EMAIL_VERIFICATION=false
